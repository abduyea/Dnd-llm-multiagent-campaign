# Database
DATABASE_URL=sqlite+aiosqlite:///./data/dnd.db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Primary model used for narration/NPCs. A small fast model keeps turns responsive.
OLLAMA_MODEL=llama3.2:3b
# Per-call timeouts in seconds (primary model, then fallback models).
OLLAMA_TIMEOUT=60
OLLAMA_FALLBACK_TIMEOUT=45
# Max seconds to wait for the TCP connection itself (unreachable host fails fast).
OLLAMA_CONNECT_TIMEOUT=5
# Heavier models tried only if the primary fails (comma-separated; empty disables).
OLLAMA_FALLBACK_MODELS=qwen3,mistral-nemo
# Keep the model loaded between turns (e.g. 30m, 1h, -1 for forever).
OLLAMA_KEEP_ALIVE=30m
# Max tokens generated per call (bounds turn length on slower hardware).
OLLAMA_NUM_PREDICT=220
# Set to 1 to preload the model at server startup so the first turn isn't cold.
OLLAMA_WARMUP=0

# Web server
# Comma-separated list of browser origins allowed to call the API. Use "*" to
# allow any origin (credentials are automatically disabled in that case).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
